<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/bg" android:orientation="vertical">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:padding="8dp">
        <ImageButton android:id="@+id/btnBackAdmin" android:layout_width="40dp" android:layout_height="40dp" android:background="@drawable/bg_rounded_input_bg" android:src="@drawable/ic_arrow_back" android:contentDescription="Back" />
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:layout_weight="1" android:text="Quản lý cộng đồng" android:textColor="@color/text_primary" android:textSize="16sp" android:textStyle="bold" />
        <Button android:id="@+id/btnSyncCounts" android:layout_width="wrap_content" android:layout_height="36dp" android:text="Đồng bộ" android:textSize="11sp" android:textAllCaps="false" android:backgroundTint="@color/blue_accent" android:textColor="@color/white" />
    </LinearLayout>
    <androidx.recyclerview.widget.RecyclerView android:id="@+id/rvPosts" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" />
</LinearLayout>
