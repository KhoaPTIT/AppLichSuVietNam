<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/bg" android:orientation="vertical">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:padding="8dp">
        <ImageButton android:id="@+id/btnBack" android:layout_width="40dp" android:layout_height="40dp" android:background="@drawable/bg_rounded_input_bg" android:src="@drawable/ic_arrow_back" android:contentDescription="Back" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:text="Đổi mật khẩu" android:textColor="@color/text_primary" android:textSize="18sp" android:textStyle="bold" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
        <EditText android:id="@+id/etOldPassword" android:layout_width="match_parent" android:layout_height="48dp" android:hint="Mật khẩu cũ" android:inputType="textPassword" android:background="@drawable/bg_input" android:paddingHorizontal="16dp" android:textSize="14sp" android:layout_marginBottom="12dp" />
        <EditText android:id="@+id/etNewPassword" android:layout_width="match_parent" android:layout_height="48dp" android:hint="Mật khẩu mới (tối thiểu 8 ký tự)" android:inputType="textPassword" android:background="@drawable/bg_input" android:paddingHorizontal="16dp" android:textSize="14sp" android:layout_marginBottom="12dp" />
        <EditText android:id="@+id/etConfirmPassword" android:layout_width="match_parent" android:layout_height="48dp" android:hint="Xác nhận mật khẩu mới" android:inputType="textPassword" android:background="@drawable/bg_input" android:paddingHorizontal="16dp" android:textSize="14sp" android:layout_marginBottom="20dp" />
        <Button android:id="@+id/btnSave" android:layout_width="match_parent" android:layout_height="48dp" android:text="Lưu mật khẩu mới" android:textAllCaps="false" android:backgroundTint="@color/red_primary" android:textColor="@color/white" />
    </LinearLayout>
</LinearLayout>
