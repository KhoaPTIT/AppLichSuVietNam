<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:padding="8dp">
        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_rounded_input_bg"
            android:src="@drawable/ic_arrow_back"
            android:contentDescription="Back" />
        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:text="@string/forgot_title"
            android:textColor="@color/text_primary"
            android:textSize="18sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Step Email -->
    <LinearLayout
        android:id="@+id/layoutEmail"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="24dp">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/forgot_desc"
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            android:lineSpacingMultiplier="1.6" />
        <EditText
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_input"
            android:hint="@string/hint_email_placeholder"
            android:inputType="textEmailAddress"
            android:paddingHorizontal="16dp"
            android:textSize="14sp" />
        <Button
            android:id="@+id/btnSendOtp"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_button_filled"
            android:text="@string/send_otp"
            android:textAllCaps="false"
            android:textColor="@color/white" />
    </LinearLayout>

    <!-- Step OTP -->
    <LinearLayout
        android:id="@+id/layoutOtp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="24dp"
        android:visibility="gone">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/otp_sent_to"
            android:textColor="@color/text_secondary"
            android:textSize="13sp" />
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="20dp"
            android:orientation="horizontal">
            <EditText android:layout_width="44dp" android:layout_height="48dp" android:background="@drawable/bg_input" android:gravity="center" android:inputType="number" android:maxLength="1" android:textSize="20sp" android:textStyle="bold" />
            <EditText android:layout_width="44dp" android:layout_height="48dp" android:layout_marginStart="8dp" android:background="@drawable/bg_input" android:gravity="center" android:inputType="number" android:maxLength="1" android:textSize="20sp" android:textStyle="bold" />
            <EditText android:layout_width="44dp" android:layout_height="48dp" android:layout_marginStart="8dp" android:background="@drawable/bg_input" android:gravity="center" android:inputType="number" android:maxLength="1" android:textSize="20sp" android:textStyle="bold" />
            <EditText android:layout_width="44dp" android:layout_height="48dp" android:layout_marginStart="8dp" android:background="@drawable/bg_input" android:gravity="center" android:inputType="number" android:maxLength="1" android:textSize="20sp" android:textStyle="bold" />
            <EditText android:layout_width="44dp" android:layout_height="48dp" android:layout_marginStart="8dp" android:background="@drawable/bg_input" android:gravity="center" android:inputType="number" android:maxLength="1" android:textSize="20sp" android:textStyle="bold" />
            <EditText android:layout_width="44dp" android:layout_height="48dp" android:layout_marginStart="8dp" android:background="@drawable/bg_input" android:gravity="center" android:inputType="number" android:maxLength="1" android:textSize="20sp" android:textStyle="bold" />
        </LinearLayout>
        <Button
            android:id="@+id/btnConfirmOtp"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_button_filled"
            android:text="@string/confirm"
            android:textAllCaps="false"
            android:textColor="@color/white" />
    </LinearLayout>

    <!-- Step Reset -->
    <LinearLayout
        android:id="@+id/layoutReset"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="24dp"
        android:visibility="gone">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/reset_desc"
            android:textColor="@color/text_secondary"
            android:textSize="13sp" />
        <EditText
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_input"
            android:hint="@string/hint_min_8_chars"
            android:inputType="textPassword"
            android:paddingHorizontal="16dp"
            android:textSize="14sp" />
        <EditText
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_input"
            android:hint="@string/hint_password_placeholder"
            android:inputType="textPassword"
            android:paddingHorizontal="16dp"
            android:textSize="14sp" />
        <Button
            android:id="@+id/btnResetPassword"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_button_filled"
            android:text="@string/reset_password"
            android:textAllCaps="false"
            android:textColor="@color/white" />
    </LinearLayout>

    <!-- Step Done -->
    <LinearLayout
        android:id="@+id/layoutDone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingHorizontal="32dp"
        android:visibility="gone">
        <FrameLayout
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:background="@drawable/bg_rounded_card"
            android:backgroundTint="@color/success_bg">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="✓"
                android:textColor="@color/success"
                android:textSize="28sp"
                android:textStyle="bold" />
        </FrameLayout>
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/reset_success"
            android:textColor="@color/text_primary"
            android:textSize="18sp"
            android:textStyle="bold" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="@string/reset_success_desc"
            android:textColor="@color/text_secondary"
            android:textSize="13sp" />
        <Button
            android:id="@+id/btnBackToLogin"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="24dp"
            android:background="@drawable/bg_button_filled"
            android:text="@string/back_to_login"
            android:textAllCaps="false"
            android:textColor="@color/white" />
    </LinearLayout>
</LinearLayout>
